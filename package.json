{
  "name": "Harness Lens",
  "version": "0.1.0",
  "description": "HarnessLens analyzes how teams use AI coding workflows, skills, MCP tools, and agents to identify high-cost, low-success, high-intervention, and rework patterns, providing verifiable evidence for harness improvement.",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "vite dev",
    "dev:tauri": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "pnpm test:e2e",
    "test:e2e": "pnpm tauri build --debug --no-bundle --ci --features e2e --config src-tauri/tauri.e2e.conf.json && wdio run wdio.conf.js",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-log": "2.8.0",
    "@tauri-apps/plugin-opener": "2.5.0",
    "@tauri-apps/plugin-updater": "2.9.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "2.10.1",
    "@wdio/cli": "^9.29.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/native-utils": "^2.5.0",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/tauri-plugin": "^1.2.0",
    "@wdio/tauri-service": "^1.2.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "webdriverio": "^9.29.1"
  }
}
